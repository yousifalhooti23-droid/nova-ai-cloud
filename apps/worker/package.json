{
  "name": "@nova/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "dev:remote-ai": "wrangler dev --remote --ip 0.0.0.0 --port 8787",
    "dev:node": "tsx watch src/node.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nova-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nova-db --remote",
    "tail": "wrangler tail",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nova/shared": "*",
    "hono": "^4.6.14",
    "@hono/node-server": "^1.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "tsx": "^4.19.2",
    "wrangler": "^4.0.0",
    "@types/node": "^20.17.0"
  }
}