{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-ai-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Serve the built web app from the same Worker (single origin => no CORS pain).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-db",
      "database_id": "REPLACE_WITH_REAL_D1_ID",
      "migrations_dir": "migrations"
    }
  ],

  // NOTE: R2 is intentionally optional (not required!) so NOVA deploys 100% FREE
  // on Cloudflare Workers WITHOUT needing a credit card on file. Binary uploads
  // and generated images/videos are stored automatically in D1 (5 GB free).
  // If you later enable R2, add: "r2_buckets": [{ "binding": "FILES", "bucket_name": "nova-files" }]

  // Workers AI (Free plan: 10,000 Neurons/day — powers both chat & Flux image generation!).
  "ai": { "binding": "AI" },

  // Isolated sandbox Worker (no secrets, no D1, no R2). Auto-deployed by deploy-cloudflare.
  "services": [
    { "binding": "SANDBOX", "service": "nova-sandbox" }
  ],

  "vars": {
    "NOVA_RUNTIME": "workers",
    "NOVA_SANDBOX": "worker-isolate",
    "NOVA_VERSION": "0.2.0"
  }
}
