# ============================================================================
# NOVA AI Cloud — environment template
# ----------------------------------------------------------------------------
# Copy to `.dev.vars` (for `wrangler dev`) or `.env` (for the Node dev runtime).
# NEVER put these values in the frontend. The web app talks only to /api/*.
# ============================================================================

# ---- Runtime mode -----------------------------------------------------------
# "workers" = Cloudflare Workers (production / wrangler dev)
# "node"    = local Node runtime used by `npm run dev:node` (file-based store)
NOVA_RUNTIME=workers

# ---- Model Router -----------------------------------------------------------
# Comma separated provider priority. The router walks this list and uses the
# first provider that is (a) configured and (b) serves the requested model.
NOVA_PROVIDER_PRIORITY=workers-ai,openrouter,custom

# ---- Provider: Cloudflare Workers AI ---------------------------------------
# Requires the `AI` binding (see apps/worker/wrangler.jsonc).
# Free plan: 10,000 Neurons/day. Verified 2026-10-30.
# LOCAL DEV: the AI binding only works with `wrangler dev --remote` + `wrangler login`
#            (or CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID). Otherwise the
#            router reports provider status "needs-remote" instead of faking output.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---- Provider: OpenRouter (OpenAI-compatible) ------------------------------
# Free models use the ":free" suffix. Public model list needs no key:
# https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Provider: Groq (OpenAI-compatible) ------------------------------------
# NOTE: verified 2026-10-30 — most Groq chat models are now Enterprise/paid.
# Only configure this if your account actually has access.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Provider: any OpenAI-compatible endpoint ------------------------------
# Ollama, LM Studio, vLLM, Together, OpenAI, Anthropic-via-proxy, ...
NOVA_CUSTOM_BASE_URL=
NOVA_CUSTOM_API_KEY=
# Optional: restrict which upstream ids this provider serves (comma separated).
NOVA_CUSTOM_MODELS=

# ---- Default model per class (optional; sane defaults exist) ---------------
NOVA_MODEL_CHAT=
NOVA_MODEL_REASONING=
NOVA_MODEL_CODING=
NOVA_MODEL_LONG_CONTEXT=

# ---- Diagnostic echo provider (NOT a real model) ---------------------------
# Off by default. When on, the UI shows a permanent warning banner. It only
# echoes your prompt so you can test streaming/tools/storage plumbing with no
# API key. It never pretends to be an AI answer.
NOVA_ENABLE_DIAGNOSTIC=false

# ---- Runtime key injection (optional, memory only) -------------------------
# When true, POST /api/admin/provider-keys can set a key for the current
# isolate lifetime. Keys are never persisted to D1/R2 and never returned.
NOVA_ALLOW_RUNTIME_KEYS=false
NOVA_ADMIN_TOKEN=

# ---- Sandbox (code execution) ---------------------------------------------
# "disabled"      = terminal/verify tools return an explicit "not configured" error
# "worker"        = isolated sandbox Worker via service binding (JS only, no fs/net)
# "http"          = any external sandbox service implementing the Nova sandbox API
NOVA_SANDBOX=disabled
NOVA_SANDBOX_URL=
NOVA_SANDBOX_TOKEN=
NOVA_SANDBOX_TIMEOUT_MS=20000

# ---- Storage --------------------------------------------------------------
# Node runtime only: where the file-based store + uploads live.
NOVA_DATA_DIR=./.nova-data

# ---- Security -------------------------------------------------------------
# Comma separated origins allowed to call the API (CORS). Empty = same-origin only.
NOVA_ALLOWED_ORIGINS=
# Max upload size in bytes (R2 / file store).
NOVA_MAX_UPLOAD_BYTES=8388608
